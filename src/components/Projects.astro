---
import { getProjects } from "@/data/projects"
import ProjectCard from "@/components/ProjectCard.astro"
import type TranslationMessages from "@/types.d.ts"

interface Props {
  m: TranslationMessages
}

const { m } = Astro.props
const projects = getProjects(m)
---

<div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(240px,1fr))]">
  {projects.map((p) => (
    <ProjectCard
      icon={p.icon}
      status={p.status}
      statusLabel={p.statusLabel}
      title={p.title}
      description={p.description}
      metric={p.metric}
      highlights={p.highlights}
      stack={p.stack}
      primaryUrl={p.primaryUrl}
      primaryLabel={p.primaryLabel}
      articleUrl={p.articleUrl}
      articleLabel={m.project_article}
    />
  ))}
</div>
